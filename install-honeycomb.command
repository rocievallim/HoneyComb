#!/bin/bash
# Honeycomb — self-contained macOS installer. Requires macOS 13 or newer.
set -Eeuo pipefail
umask 022

if [ "$(/usr/bin/uname -s)" != "Darwin" ]; then
    echo "Honeycomb requires macOS." >&2
    exit 1
fi
if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    echo "Run this installer as your normal user, not with sudo." >&2
    exit 1
fi
if [ "$(/usr/sbin/sysctl -in sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
    exec /usr/bin/arch -arm64 /bin/bash "$0" "$@"
fi
HC_MAJOR=$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d. -f1)
if [ "$HC_MAJOR" -lt 13 ]; then
    echo "Honeycomb requires macOS 13 or newer." >&2
    exit 1
fi
HC_BASE="$HOME/honeycomb"
HC_APP="/Applications/Honeycomb.app"
HC_STAGE=""
HC_DEST_STAGE=""
HC_EXT_STAGE=""
HC_BACKUP=""
HC_COMPLETE=0
HC_LOCK="$HC_BASE/.installer-lock"
/bin/mkdir -p "$HC_BASE"
if ! /bin/mkdir "$HC_LOCK" 2>/dev/null; then
    HC_OLD_PID=$(/bin/cat "$HC_LOCK/pid" 2>/dev/null || true)
    case "$HC_OLD_PID" in
        ''|*[!0-9]*) ;;
        *) if /bin/kill -0 "$HC_OLD_PID" 2>/dev/null; then echo "Another Honeycomb installer is running."; exit 1; fi ;;
    esac
    /bin/rm -rf "$HC_LOCK"
    /bin/mkdir "$HC_LOCK"
fi
printf '%s\n' "$$" > "$HC_LOCK/pid"
exec > >(/usr/bin/tee -a "$HC_BASE/install.log") 2>&1
cleanup() {
    if [ -n "$HC_BACKUP" ] && [ -d "$HC_BACKUP" ]; then
        if [ "$HC_COMPLETE" -eq 0 ]; then
            hc_privileged /bin/rm -rf "$HC_APP"
            hc_privileged /bin/mv "$HC_BACKUP" "$HC_APP"
            echo "The previous Honeycomb.app was restored."
        else
            hc_privileged /bin/rm -rf "$HC_BACKUP"
        fi
    fi
    if [ -n "$HC_DEST_STAGE" ] && [ -d "$HC_DEST_STAGE" ]; then hc_privileged /bin/rm -rf "$HC_DEST_STAGE"; fi
    if [ -n "$HC_STAGE" ] && [ -d "$HC_STAGE" ]; then /bin/rm -rf "$HC_STAGE"; fi
    if [ -n "$HC_EXT_STAGE" ] && [ -d "$HC_EXT_STAGE" ]; then /bin/rm -rf "$HC_EXT_STAGE"; fi
    /bin/rm -rf "$HC_LOCK"
}
failed() {
    HC_STATUS="$1"
    echo
    echo "Installation stopped on line $2 (status $HC_STATUS)."
    echo "Details: $HC_BASE/install.log"
    echo "Fix the reported issue and double-click this installer again."
    if [ -t 0 ]; then read -r -p "Press Return to close. " _ || true; fi
    exit "$HC_STATUS"
}
trap cleanup EXIT
trap 'failed $? $LINENO' ERR

echo "Installing Honeycomb…"
echo "The installer may ask for your Mac password and Command Line Tools."
echo "Full Xcode is not required."

hc_stop_honeycomb() {
    HC_PATTERN='^/Applications/Honeycomb[.]app/Contents/MacOS/Honeycomb([[:space:]]|$)'
    /usr/bin/pkill -TERM -f "$HC_PATTERN" 2>/dev/null || true
    for HC_I in {1..50}; do
        if ! /usr/bin/pgrep -f "$HC_PATTERN" >/dev/null; then break; fi
        /bin/sleep 0.1
    done
    if /usr/bin/pgrep -f "$HC_PATTERN" >/dev/null; then
        /usr/bin/pkill -KILL -f "$HC_PATTERN" 2>/dev/null || true
    fi
}

hc_reset_permission() {
    echo "Refreshing $2 for Honeycomb…"
    if /usr/bin/tccutil reset "$1" app.honeycomb.personal; then
        return 0
    fi
    echo "In $2, remove the existing Honeycomb entry, then add $HC_APP and turn it on."
    return 1
}

hc_bundle_cdhash() {
    /usr/bin/codesign -d --verbose=4 "$1" 2>&1 | /usr/bin/awk -F= '$1 == "CDHash" { print $2 }'
}

hc_launch_for_permissions() {
    local pane="$1"
    shift
    /usr/bin/open -g "$HC_APP" --args --background "$@"
    /usr/bin/open "x-apple.systempreferences:com.apple.preference.security?$pane"
}

if [ "${1:-}" = "--repair-accessibility" ] || [ "${1:-}" = "--repair-input-monitoring" ]; then
    if [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$HC_APP/Contents/Info.plist" 2>/dev/null || true)" != "app.honeycomb.personal" ]; then
        echo "Install Honeycomb before repairing its permissions."
        exit 1
    fi
    hc_stop_honeycomb
    HC_REPAIR_STATUS=0
    if [ "$1" = "--repair-input-monitoring" ]; then
        hc_reset_permission ListenEvent "Input Monitoring" || HC_REPAIR_STATUS=1
        hc_launch_for_permissions Privacy_ListenEvent --request-input-monitoring
        echo "Turn on Input Monitoring for $HC_APP."
    else
        hc_reset_permission Accessibility Accessibility || HC_REPAIR_STATUS=1
        hc_launch_for_permissions Privacy_Accessibility --request-accessibility
        echo "Turn on Accessibility for $HC_APP."
    fi
    exit "$HC_REPAIR_STATUS"
fi

HC_BREW=""
if [ -x /opt/homebrew/bin/brew ]; then HC_BREW=/opt/homebrew/bin/brew
elif [ -x /usr/local/bin/brew ]; then HC_BREW=/usr/local/bin/brew
elif command -v brew >/dev/null 2>&1; then HC_BREW=$(command -v brew)
fi
if [ -z "$HC_BREW" ]; then
    HC_BOOTSTRAP=$(/usr/bin/mktemp -t honeycomb-homebrew)
    /usr/bin/curl --fail --location --show-error --silent https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$HC_BOOTSTRAP"
    /bin/bash "$HC_BOOTSTRAP"
    /bin/rm -f "$HC_BOOTSTRAP"
    if [ -x /opt/homebrew/bin/brew ]; then HC_BREW=/opt/homebrew/bin/brew
    else HC_BREW=/usr/local/bin/brew; fi
fi
eval "$("$HC_BREW" shellenv)"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export HOMEBREW_NO_ENV_HINTS=1
hc_download_checked() {
    /usr/bin/curl --fail --location --silent --show-error --connect-timeout 10 --max-time 120 \
        "$1" -o "$3.partial" || return 1
    [ "$(/usr/bin/shasum -a 256 "$3.partial" | /usr/bin/awk '{print $1}')" = "$2" ] || return 1
    /bin/mv "$3.partial" "$3"
}

hc_magick_library() {
    case "$HC_RID" in
        osx-arm64) hc_download_checked "https://dl.filee.sh/engines/magick-native/2026.1010.1943/Magick.Native-Q8-arm64.dll.dylib" "d8c4f6733e50e3457d5324291d1f96cb859d8f2e8983c94fd405b07c89a14e6d" "$1" ;;
        osx-x64) hc_download_checked "https://dl.filee.sh/engines/magick-native/2026.1010.1943/Magick.Native-Q8-x64.dll.dylib" "40852de95f53128cb0a77edc6857eb62d0e866ef1c34de42673b539c1bd4a898" "$1" ;;
    esac
}

hc_unpack_engine() {
    local download="$HC_EXT_STAGE/$3.tar" unpacked="$HC_EXT_STAGE/unpacked-$3"
    local members="$HC_EXT_STAGE/members-$3" details="$HC_EXT_STAGE/details-$3"
    hc_download_checked "$1" "$2" "$download" || return 1
    /usr/bin/tar -tf "$download" > "$members" || return 1
    /usr/bin/tar -tvf "$download" > "$details" || return 1
    if /usr/bin/grep -Eq '(^/|(^|/)\.\.(/|$)|[:\\])' "$members" ||
       /usr/bin/grep -Eq '^[^-d]' "$details"; then return 1; fi
    /bin/mkdir "$unpacked" || return 1
    /usr/bin/tar -xf "$download" -C "$unpacked" || return 1
    local executable
    executable=$(/usr/bin/find "$unpacked" -maxdepth 2 -type f -name "$4" -print -quit)
    [ -n "$executable" ] || return 1
    /bin/chmod 755 "$executable" || return 1
    /bin/mkdir -p "$HC_EXT_STAGE/bin/engines" || return 1
    /bin/mkdir "$HC_EXT_STAGE/bin/engines/$3" || return 1
    /usr/bin/ditto "${executable%/*}" "$HC_EXT_STAGE/bin/engines/$3"
}

hc_portable_engine() {
    case "$HC_RID:$1" in
        osx-arm64:7zip) hc_unpack_engine "https://github.com/ip7z/7zip/releases/download/25.01/7z2501-mac.tar.xz" "26aa75bc262bb10bf0805617b95569c3035c2c590a99f7db55c7e9607b2685e0" "7zip" "7zz" ;;
        osx-arm64:rhwp) hc_unpack_engine "https://github.com/edwardkim/rhwp/releases/download/v0.8.7/rhwp-v0.8.7-macos-aarch64.tar.gz" "6ed46aa63f6d10c447842999f73abc59cf9586c5645fefc5e763bd6a6d43662d" "rhwp" "rhwp" ;;
        osx-x64:7zip) hc_unpack_engine "https://github.com/ip7z/7zip/releases/download/25.01/7z2501-mac.tar.xz" "26aa75bc262bb10bf0805617b95569c3035c2c590a99f7db55c7e9607b2685e0" "7zip" "7zz" ;;
        osx-x64:rhwp) hc_unpack_engine "https://github.com/edwardkim/rhwp/releases/download/v0.8.7/rhwp-v0.8.7-macos-x86_64.tar.gz" "07b1a5ea570e410d1b52b4d848a94f00c64674e84004883c62efad7daab61da4" "rhwp" "rhwp" ;;
    esac
}

# The optional engine is built from the Filee sources embedded below.
hc_setup_extended() {
    HC_EXT_ROOT="$HC_BASE/extended"
    HC_EXT_HASH="53af8e9eb7e82223ecb57b2450ac7ba602e5dc05cf5ad53286f41e00e8c10eb4"
    if [ -x "$HC_EXT_ROOT/bin/filee-cli" ] &&
       [ "$(/bin/cat "$HC_EXT_ROOT/bin/.source-hash" 2>/dev/null || true)" = "$HC_EXT_HASH" ]; then
        echo "Extended formats are already installed."
        return 0
    fi
    echo "Setting up extended formats. The first build downloads .NET and its dependencies."
    HC_DOTNET="$(command -v dotnet || true)"
    if [ -z "$HC_DOTNET" ] || ! "$HC_DOTNET" --list-sdks 2>/dev/null | /usr/bin/awk '
        $1 ~ /^[0-9]+\./ { split($1, version, "."); if (version[1] >= 10) found = 1 }
        END { exit !found }
    '; then
        "$HC_BREW" install dotnet || return 1
        HC_DOTNET="$("$HC_BREW" --prefix dotnet)/bin/dotnet"
    fi
    [ -x "$HC_DOTNET" ] || return 1
    /bin/mkdir -p "$HC_EXT_ROOT/data" || return 1
    HC_EXT_STAGE=$(/usr/bin/mktemp -d "$HC_EXT_ROOT/.build.XXXXXX") || return 1
    /usr/bin/base64 -D > "$HC_EXT_STAGE/source.zip" <<'HONEYCOMB_FILEE_SOURCE'
